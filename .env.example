# FairDrop Root Environment Variables (Optional overrides for scripts/seed.js and scripts/e2e-smoke.js)
# Copy this file to .env if running scripts from the root repository directory.

# ── MongoDB Configuration (scripts/seed.js) ───────────────────
MONGODB_URI=mongodb://localhost:27017/fairdrop_core

# ── MySQL Configuration (scripts/seed.js) ─────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fairdrop_pay

# ── Service Endpoints (scripts/e2e-smoke.js) ──────────────────
CORE_URL=http://localhost:3003
PAY_URL=http://localhost:3001
