# FairDrop Pay Service — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── MySQL Connection ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fairdrop_pay

# ── Server ───────────────────────────────────────────────────
PORT=3001

# ── Auth (Shared JWT_SECRET with core-service) ───────────────
JWT_SECRET=change-this-to-a-random-secret-in-production
